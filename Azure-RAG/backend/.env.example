# Provider selection
RAG_PROVIDER=local
LLM_PROVIDER=auto

# Local LLM. Required when LLM_PROVIDER=local.
OFFLINE_MODEL_PATH=/absolute/path/to/model.gguf

# Azure OpenAI. Required for LLM_PROVIDER=azure and Azure AI Search embeddings.
AZURE_OPENAI_ENDPOINT=https://your-openai-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Azure AI Search. Required when RAG_PROVIDER=azure.
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME=govtech-rag-index
AZURE_SEARCH_VECTOR_DIMENSIONS=1536

# Optional alternative online LLMs
MISTRAL_API_KEY=
MISTRAL_API_MODEL_NAME=
GEMINI_API_KEY=
GEMINI_API_MODEL_NAME=
